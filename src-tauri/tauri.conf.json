{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SplitSound",
  "version": "0.1.0",
  "identifier": "app.splitsound.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "SplitSound",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "backgroundColor": "#384C58",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false
      },
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "media-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "SplitSound contributors",
    "copyright": "Copyright (c) SplitSound contributors. MIT licence.",
    "license": "MIT",
    "homepage": "https://github.com/Omaaarkhan/splitsound",
    "category": "Music",
    "shortDescription": "Split any song into stems on your own computer.",
    "longDescription": "SplitSound splits songs into vocals, drums, bass, guitar, piano and everything else, and tells you which instruments it hears. Everything runs on your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mp3"],
        "name": "MP3 audio",
        "description": "MP3 audio",
        "mimeType": "audio/mpeg",
        "contentTypes": ["public.mp3"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["wav", "wave"],
        "name": "WAV audio",
        "description": "WAV audio",
        "mimeType": "audio/wav",
        "contentTypes": ["com.microsoft.waveform-audio"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["flac"],
        "name": "FLAC audio",
        "description": "FLAC audio",
        "mimeType": "audio/flac",
        "contentTypes": ["org.xiph.flac"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["aif", "aiff", "aifc"],
        "name": "AIFF audio",
        "description": "AIFF audio",
        "mimeType": "audio/aiff",
        "contentTypes": ["public.aiff-audio", "public.aifc-audio"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["m4a", "aac"],
        "name": "AAC audio",
        "description": "AAC audio",
        "mimeType": "audio/mp4",
        "contentTypes": ["com.apple.m4a-audio", "public.mpeg-4-audio", "public.aac-audio"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["ogg", "oga", "opus"],
        "name": "Ogg audio",
        "description": "Ogg Vorbis or Opus audio",
        "mimeType": "audio/ogg",
        "contentTypes": ["org.xiph.ogg-audio"],
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "linux": {
      "deb": {
        "depends": ["libasound2"]
      },
      "rpm": {
        "depends": ["alsa-lib"]
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMDYwQzQyRDhCOTM5MEQKUldRTk9ibllRZ3dHOG5oeTBCcThTNTJSRDJJZi92TFlRSjdqQkhIQ1BoV2xNdHhDU1pBUzRrcVYK",
      "endpoints": [
        "https://github.com/Omaaarkhan/splitsound/releases/latest/download/latest.json"
      ]
    }
  }
}
