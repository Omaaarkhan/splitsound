{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least privilege for the main window: the app's own commands, event listening, window dragging for the custom title bar, the open-file dialog, and dragging prepared stems out. Nothing else.",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "dialog:allow-open",
    "drag:allow-start-drag",
    "allow-list-sessions",
    "allow-import-track",
    "allow-get-session",
    "allow-delete-session",
    "allow-clear-library",
    "allow-get-artwork",
    "allow-get-peaks",
    "allow-get-session-peaks",
    "allow-estimate-split",
    "allow-start-split",
    "allow-cancel-split",
    "allow-playback-load",
    "allow-playback-unload",
    "allow-playback-play",
    "allow-playback-pause",
    "allow-playback-seek",
    "allow-playback-set-channel",
    "allow-playback-set-master",
    "allow-playback-set-source",
    "allow-playback-set-loop",
    "allow-export-stems",
    "allow-prepare-drag",
    "allow-list-models",
    "allow-download-models",
    "allow-cancel-model-downloads",
    "allow-remove-model",
    "allow-import-model-files",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-app-info",
    "allow-reveal-path",
    "allow-check-for-update",
    "allow-install-update"
  ]
}
