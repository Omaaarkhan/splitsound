{
  "name": "splitsound",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Split any song into vocals and instruments, on your own computer.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx,mjs}\" index.html vite.config.ts vitest.config.ts eslint.config.js",
    "test": "vitest run",
    "shots": "node tests/shots.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/just-another-hand": "^5.3.0",
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright-core": "1.65.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.16",
    "vitest": "^5.1.1"
  }
}
